<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="PathIcon.playback-loader[IsVisible=True]">
        <Style.Animations>
            <Animation Duration="0:0:0.8" IterationCount="Infinite" Easing="LinearEasing">
                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="360" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.icon-button.transport">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.track-row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppSurfaceRaisedBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).track-title">
        <Setter Property="Opacity" Value="0.78" />
    </Style>
    <Style Selector="Grid.playing-indicator, PathIcon.paused-indicator">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border.track-row:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceRaisedBrush}" />
    </Style>
    <Style Selector="Border.track-row.current, Border.track-row.current:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}" />
    </Style>
    <Style Selector="Border.track-row.current :is(TextBlock).track-title">
        <Setter Property="Foreground" Value="{DynamicResource AppPrimaryHoverBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.track-row.current.playing Grid.playing-indicator, Border.track-row.current:not(.playing) PathIcon.paused-indicator">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.equalizer-bar">
        <Setter Property="Background" Value="{DynamicResource AppPrimaryHoverBrush}" />
        <Setter Property="CornerRadius" Value="0.5" />
    </Style>
    <Style Selector="Border.track-row.current.playing Border.equalizer-bar.left">
        <Style.Animations>
            <Animation Duration="0:0:0.72" IterationCount="Infinite" Easing="SineEaseInOut">
                <KeyFrame Cue="0%">
                    <Setter Property="ScaleTransform.ScaleY" Value="0.35" />
                </KeyFrame>
                <KeyFrame Cue="25%">
                    <Setter Property="ScaleTransform.ScaleY" Value="0.9" />
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="ScaleTransform.ScaleY" Value="0.5" />
                </KeyFrame>
                <KeyFrame Cue="75%">
                    <Setter Property="ScaleTransform.ScaleY" Value="1" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="ScaleTransform.ScaleY" Value="0.35" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Border.track-row.current.playing Border.equalizer-bar.middle">
        <Style.Animations>
            <Animation Duration="0:0:0.93" IterationCount="Infinite" Easing="SineEaseInOut">
                <KeyFrame Cue="0%">
                    <Setter Property="ScaleTransform.ScaleY" Value="0.85" />
                </KeyFrame>
                <KeyFrame Cue="25%">
                    <Setter Property="ScaleTransform.ScaleY" Value="0.3" />
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="ScaleTransform.ScaleY" Value="1" />
                </KeyFrame>
                <KeyFrame Cue="75%">
                    <Setter Property="ScaleTransform.ScaleY" Value="0.5" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="ScaleTransform.ScaleY" Value="0.85" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Border.track-row.current.playing Border.equalizer-bar.right">
        <Style.Animations>
            <Animation Duration="0:0:0.81" IterationCount="Infinite" Easing="SineEaseInOut">
                <KeyFrame Cue="0%">
                    <Setter Property="ScaleTransform.ScaleY" Value="0.55" />
                </KeyFrame>
                <KeyFrame Cue="25%">
                    <Setter Property="ScaleTransform.ScaleY" Value="1" />
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="ScaleTransform.ScaleY" Value="0.25" />
                </KeyFrame>
                <KeyFrame Cue="75%">
                    <Setter Property="ScaleTransform.ScaleY" Value="0.8" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="ScaleTransform.ScaleY" Value="0.55" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button.playlist-title">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.playlist-title:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppPrimaryHoverBrush}" />
    </Style>
    <Style Selector="Button.playlist-title:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.playlist-list">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.playlist-list ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="Stretch" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.playlist-list ScrollBar:vertical">
        <Setter Property="Width" Value="4" />
        <Setter Property="MinWidth" Value="4" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="AllowAutoHide" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Track Name="PART_Track"
                       Orientation="Vertical"
                       IsDirectionReversed="True"
                       Minimum="{TemplateBinding Minimum}"
                       Maximum="{TemplateBinding Maximum}"
                       Value="{TemplateBinding Value, Mode=TwoWay}"
                       ViewportSize="{TemplateBinding ViewportSize}">
                    <Track.Thumb>
                        <Thumb MinHeight="24">
                            <Thumb.Template>
                                <ControlTemplate>
                                    <Border Name="ThumbSurface"
                                            Background="{DynamicResource AppTextMutedBrush}"
                                            CornerRadius="2"
                                            Opacity="0.6" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                </Track>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.playlist-list ScrollBar Thumb:pointerover /template/ Border#ThumbSurface">
        <Setter Property="Background" Value="{DynamicResource AppPrimaryHoverBrush}" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Grid.playlist-cover Button.cover-play">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="CornerRadius" Value="18" />
    </Style>
    <Style Selector="ComboBox.playlist-sort">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontFamily" Value="{DynamicResource BrandFontFamily}" />
    </Style>
    <Style Selector="Grid.playlist-cover:pointerover Button.cover-play, Grid.playlist-cover Button.cover-play:focus-visible">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Slider.vertical-volume">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="Transparent">
                    <Border Width="2" Margin="0,5" HorizontalAlignment="Center" CornerRadius="1"
                            Background="{DynamicResource AppBorderBrush}" />
                    <Track Name="PART_Track" Orientation="Vertical"
                           Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}">
                        <Track.DecreaseButton>
                            <RepeatButton Name="PART_DecreaseButton" Focusable="False" MinWidth="0" MinHeight="0" Padding="0"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <RepeatButton.Template>
                                    <ControlTemplate>
                                        <Grid Background="Transparent">
                                            <Border Name="VolumeFill" Width="2" Margin="0,-5,0,5"
                                                    HorizontalAlignment="Center" CornerRadius="1"
                                                    Background="{DynamicResource AppPrimaryBrush}" />
                                        </Grid>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Track.DecreaseButton>
                        <Track.Thumb>
                            <Thumb Width="24" Height="10">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Grid Background="Transparent">
                                            <Border Name="VolumeKnob" Width="8" Height="8"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Background="{DynamicResource AppPrimaryBrush}" CornerRadius="5" />
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseButton>
                            <RepeatButton Name="PART_IncreaseButton" Focusable="False" MinWidth="0" MinHeight="0" Padding="0"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <RepeatButton.Template>
                                    <ControlTemplate>
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Track.IncreaseButton>
                    </Track>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Slider.vertical-volume:pointerover /template/ Thumb /template/ Border#VolumeKnob">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Background" Value="{DynamicResource AppPrimaryHoverBrush}" />
    </Style>
    <Style Selector="Slider.vertical-volume:pointerover /template/ RepeatButton /template/ Border#VolumeFill">
        <Setter Property="Background" Value="{DynamicResource AppPrimaryHoverBrush}" />
    </Style>
    <Style Selector="Slider.volume-slider">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="Transparent">
                    <Border Height="2" VerticalAlignment="Center" CornerRadius="1"
                            Background="{DynamicResource AppBorderBrush}" />
                    <Track Name="PART_Track" Height="18" VerticalAlignment="Center" Orientation="Horizontal"
                           Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}">
                        <Track.DecreaseButton>
                            <RepeatButton Name="PART_DecreaseButton" Focusable="False" MinWidth="0" MinHeight="0" Padding="0"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <RepeatButton.Template>
                                    <ControlTemplate>
                                        <Grid Background="Transparent">
                                            <Border Name="VolumeFill" Height="2" Margin="0,0,-9,0"
                                                    VerticalAlignment="Center" CornerRadius="1"
                                                    Background="{DynamicResource AppPrimaryBrush}" />
                                        </Grid>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Track.DecreaseButton>
                        <Track.Thumb>
                            <Thumb Width="18" Height="18">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Grid Background="Transparent">
                                            <Border Name="VolumeKnob" Width="8" Height="8"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Background="{DynamicResource AppPrimaryBrush}" CornerRadius="5" />
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseButton>
                            <RepeatButton Name="PART_IncreaseButton" Focusable="False" MinWidth="0" MinHeight="0" Padding="0"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <RepeatButton.Template>
                                    <ControlTemplate>
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Track.IncreaseButton>
                    </Track>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Slider.volume-slider:pointerover /template/ Thumb /template/ Border#VolumeKnob">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Background" Value="{DynamicResource AppPrimaryHoverBrush}" />
    </Style>
    <Style Selector="Slider.volume-slider:pointerover /template/ RepeatButton /template/ Border#VolumeFill">
        <Setter Property="Background" Value="{DynamicResource AppPrimaryHoverBrush}" />
    </Style>
</Styles>
