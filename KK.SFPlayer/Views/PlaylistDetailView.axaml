<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:constants="using:KK.SFPlayer.Constants"
             xmlns:vm="using:KK.SFPlayer.ViewModels"
             xmlns:models="using:KK.SFPlayer.Models.Records"
             xmlns:controls="using:KK.SFPlayer.Controls"
             x:Class="KK.SFPlayer.Views.PlaylistDetailView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True">
    <Grid RowDefinitions="30,8,80,10,32,8,*">
        <Button Classes="icon-button" Command="{Binding BackCommand}"
                ToolTip.Tip="{x:Static constants:PlaylistConstants.Back}"
                AutomationProperties.Name="{x:Static constants:PlaylistConstants.Back}">
            <PathIcon Width="16" Height="16" Data="M12,2 L14,4 L7,11 L22,11 L22,13 L7,13 L14,20 L12,22 L2,12 Z"
                      Foreground="{DynamicResource AppTextBrush}" />
        </Button>
        <Grid Grid.Row="2" ColumnDefinitions="80,12,*">
            <Grid Classes="playlist-cover">
                <controls:RemoteImage Width="80" Height="80" Url="{Binding SelectedPlaylist.ImageUrl}" />
                <Button Classes="icon-button cover-play" Width="36" Height="36"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Command="{Binding PlayPlaylistCommand}"
                        ToolTip.Tip="{x:Static constants:PlaylistConstants.Play}"
                        AutomationProperties.Name="{x:Static constants:PlaylistConstants.Play}">
                    <PathIcon Width="16" Height="16" Data="M5,2 L19,12 L5,22 Z"
                              Foreground="{DynamicResource AppTextBrush}" />
                </Button>
            </Grid>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                       TextWrapping="Wrap" MaxHeight="80" TextTrimming="CharacterEllipsis"
                       Text="{Binding SelectedPlaylist.Name}" />
        </Grid>
        <Grid Grid.Row="4" ColumnDefinitions="*,8,132">
            <TextBlock VerticalAlignment="Center" FontSize="11" Text="{Binding PlaylistSummary}"
                       Foreground="{DynamicResource AppTextMutedBrush}" />
            <ComboBox Grid.Column="2" Classes="playlist-sort" HorizontalAlignment="Stretch"
                      FontSize="11" MinHeight="28" Padding="8,0"
                      VerticalContentAlignment="Center"
                      ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SelectedSort}"
                      IsEnabled="{Binding !IsBusy}"
                      ToolTip.Tip="{x:Static constants:PlaylistConstants.Sort}"
                      AutomationProperties.Name="{x:Static constants:PlaylistConstants.Sort}" />
        </Grid>
        <ListBox x:Name="TracksList" Grid.Row="6" Classes="playlist-list"
                 Padding="0,0,4,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ItemsSource="{Binding SortedTracks}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel CacheLength="0" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:TrackInfo">
                    <Border Classes="track-row" Height="32" Margin="0,0,12,0" Padding="0,0,10,0" BorderThickness="3,0,0,1"
                            Tapped="OnTrackTapped">
                        <Grid ColumnDefinitions="18,*,12,Auto">
                            <Grid Width="10" Height="12" VerticalAlignment="Center">
                                <PathIcon Classes="playing-indicator" Width="9" Height="10"
                                          Data="M0,7 H3 V16 H0 Z M5,0 H8 V16 H5 Z M10,4 H13 V16 H10 Z"
                                          Foreground="{DynamicResource AppPrimaryHoverBrush}" />
                                <PathIcon Classes="paused-indicator" Width="8" Height="10"
                                          Data="M2,2 H7 V18 H2 Z M11,2 H16 V18 H11 Z"
                                          Foreground="{DynamicResource AppPrimaryHoverBrush}" />
                            </Grid>
                            <controls:TrimmedTextBlock Grid.Column="1" Classes="track-title" VerticalAlignment="Center" FontSize="12"
                                                       Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" MinWidth="40" TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"
                                       Text="{Binding Duration}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
