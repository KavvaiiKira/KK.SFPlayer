<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:constants="using:KK.SFPlayer.Constants"
        xmlns:vm="using:KK.SFPlayer.ViewModels"
        xmlns:controls="using:KK.SFPlayer.Controls"
        xmlns:views="using:KK.SFPlayer.Views"
        x:Class="KK.SFPlayer.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Width="{Binding WindowWidth, Mode=TwoWay}"
        Height="{Binding WindowHeight, Mode=TwoWay}"
        MinWidth="{x:Static constants:WindowConstants.MinimumWidth}"
        MaxWidth="{x:Static constants:WindowConstants.MaximumWidth}"
        MinHeight="{x:Static constants:WindowConstants.MinimumHeight}"
        MaxHeight="{x:Static constants:WindowConstants.MaximumHeight}"
        CanResize="True"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        FontFamily="{DynamicResource BrandFontFamily}"
        Foreground="{DynamicResource AppTextBrush}"
        Topmost="{Binding AlwaysOnTop}"
        Icon="avares://KK.SFPlayer/Assets/Brand/kk-sfplayer.ico"
        Title="{x:Static constants:ApplicationConstants.AppName}">
    <Window.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
    </Window.KeyBindings>
    <Grid>
        <Border Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid RowDefinitions="44,*">
                <Border Background="{DynamicResource AppSurfaceBrush}"
                        CornerRadius="14,14,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <Border Background="Transparent"
                                PointerPressed="OnTitleBarPointerPressed">
                            <StackPanel Margin="12,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                <Image Width="24"
                                       Height="24"
                                       Source="avares://KK.SFPlayer/Assets/Brand/kk-brand.png" />
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppTextMutedBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="{x:Static constants:ApplicationConstants.AppName}" />
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Margin="16,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="10">
                            <Button Classes="window-control minimize"
                                    AutomationProperties.Name="{x:Static constants:WindowConstants.Minimize}"
                                    ToolTip.Tip="{x:Static constants:WindowConstants.Minimize}"
                                    Click="OnMinimizeClick" />
                            <Button Classes="window-control close"
                                    AutomationProperties.Name="{x:Static constants:WindowConstants.Close}"
                                    ToolTip.Tip="{x:Static constants:WindowConstants.Close}"
                                    Click="OnCloseClick" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1"
                      Margin="{DynamicResource PageContentMargin}"
                      RowDefinitions="*,Auto,Auto"
                      IsVisible="{Binding !IsSettingsOpen}"
                      IsEnabled="{Binding !IsLogoutConfirmationOpen}">
                    <TextBlock Margin="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextMutedBrush}"
                               FontSize="14"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{x:Static constants:SettingsConstants.EmptyClientId}"
                               IsVisible="{Binding !HasClientId}" />
                    <TextBlock Margin="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextMutedBrush}"
                               FontSize="14"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{x:Static constants:PlaylistConstants.SignInPrompt}"
                               IsVisible="{Binding NeedsLogin}" />
                    <ListBox x:Name="PlaylistsList"
                             IsVisible="{Binding ShowPlaylists}"
                             Classes="playlist-list"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemsSource="{Binding Library.PlaylistCards}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel CacheLength="0" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlaylistCardViewModel">
                                <views:PlaylistCardView />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <views:PlaylistDetailView DataContext="{Binding Playlist}" />
                    <StackPanel Grid.Row="1" Margin="0,6,0,4" Spacing="4">
                        <ProgressBar Height="2" IsIndeterminate="True" IsVisible="{Binding State.IsBusy}" />
                        <TextBlock MaxHeight="48" Text="{Binding State.Status}" IsVisible="{Binding State.HasStatus}"
                                   Foreground="{DynamicResource AppTextMutedBrush}" FontSize="12" TextWrapping="Wrap" />
                        <Button Classes="secondary compact"
                                Content="{x:Static constants:CommonConstants.Retry}"
                                Command="{Binding State.RetryCommand}"
                                IsVisible="{Binding State.HasRetry}" />
                    </StackPanel>
                    <Grid x:Name="PlaybackFooter" Grid.Row="2" RowDefinitions="22,74" ColumnDefinitions="Auto,*">
                        <Border x:Name="NowPlayingArtwork" Grid.RowSpan="2" Margin="0,0,10,0"
                                Width="{Binding #PlaybackFooter.Bounds.Height}" CornerRadius="8" ClipToBounds="True"
                                IsVisible="{Binding Playback.HasCurrentTrack}">
                            <controls:RemoteImage Url="{Binding Playback.ArtworkUrl}" Stretch="UniformToFill" CacheOnDisk="False" AutoRetry="True" />
                        </Border>
                        <controls:TrimmedTextBlock x:Name="NowPlayingTitle" Grid.Column="1" Margin="0,0,0,6"
                                                   Text="{Binding Playback.NowPlaying}" IsVisible="{Binding Playback.HasNowPlaying}"
                                                   Foreground="{DynamicResource AppTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="22,8,30" ColumnDefinitions="*,12,Auto" VerticalAlignment="Bottom">
                            <Grid Grid.ColumnSpan="3" ColumnDefinitions="40,8,*,8,40" IsVisible="{Binding State.IsConnected}">
                                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"
                                           Text="{Binding Playback.ElapsedTime}" />
                                <Slider x:Name="ProgressSlider" Grid.Column="2" Classes="volume-slider" Height="22" Minimum="0"
                                        Maximum="{Binding Playback.SeekMaximum}" Value="{Binding Playback.PositionMs, Mode=TwoWay}"
                                        IsEnabled="{Binding Playback.CanSeek}" AutomationProperties.Name="{x:Static constants:StreamingConstants.Seek}" />
                                <TextBlock Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"
                                           Foreground="{DynamicResource AppTextMutedBrush}" Text="{Binding Playback.RemainingTime}" />
                            </Grid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" IsVisible="{Binding State.IsConnected}">
                                <Button x:Name="ShuffleButton" Classes="icon-button transport" Classes.active="{Binding Playback.ShuffleEnabled}"
                                        ToolTip.Tip="{Binding Playback.ShuffleTooltip}" AutomationProperties.Name="{Binding Playback.ShuffleTooltip}"
                                        Command="{Binding Playback.ToggleShuffleCommand}">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M3,6 H6 C10,6 14,18 18,18 H22 M18,14 L22,18 L18,22 M3,18 H6 C8,18 9,15 10,13 M14,9 C16,6 17,6 18,6 H22 M18,2 L22,6 L18,10"
                                                  Stroke="{DynamicResource AppTextBrush}" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Button x:Name="PreviousTrackButton" Classes="icon-button transport"
                                        ToolTip.Tip="{x:Static constants:StreamingConstants.Previous}"
                                        AutomationProperties.Name="{x:Static constants:StreamingConstants.Previous}"
                                        Command="{Binding Playback.PreviousTrackCommand}">
                                    <PathIcon Width="14" Height="14" Data="M3,3 H6 V21 H3 Z M21,3 V21 L7,12 Z"
                                              Foreground="{DynamicResource AppTextBrush}" />
                                </Button>
                                <Button x:Name="PlaybackButton" Classes="icon-button"
                                        ToolTip.Tip="{Binding Playback.PlaybackTooltip}"
                                        AutomationProperties.Name="{Binding Playback.PlaybackTooltip}"
                                        Command="{Binding Playback.TogglePlaybackCommand}">
                                    <Grid Width="16" Height="16">
                                        <Grid IsVisible="{Binding !Playback.IsLoading}">
                                            <PathIcon Width="16" Height="16" IsVisible="{Binding Playback.IsPlaying}"
                                                      Data="M3,2 L9,2 L9,22 L3,22 Z M15,2 L21,2 L21,22 L15,22 Z"
                                                      Foreground="{DynamicResource AppTextBrush}" />
                                            <PathIcon Width="16" Height="16" IsVisible="{Binding !Playback.IsPlaying}"
                                                      Data="M5,2 L19,12 L5,22 Z"
                                                      Foreground="{DynamicResource AppTextBrush}" />
                                        </Grid>
                                        <PathIcon x:Name="PlaybackLoader" Classes="playback-loader" Width="16" Height="16"
                                                  IsVisible="{Binding Playback.IsLoading}" RenderTransformOrigin="50%,50%"
                                                  Data="M8,0 A8,8 0 1 1 0,8 L2,8 A6,6 0 1 0 8,2 Z"
                                                  Foreground="{DynamicResource AppPrimaryHoverBrush}">
                                            <PathIcon.RenderTransform>
                                                <RotateTransform />
                                            </PathIcon.RenderTransform>
                                        </PathIcon>
                                    </Grid>
                                </Button>
                                <Button x:Name="NextTrackButton" Classes="icon-button transport"
                                        ToolTip.Tip="{x:Static constants:StreamingConstants.Next}"
                                        AutomationProperties.Name="{x:Static constants:StreamingConstants.Next}"
                                        Command="{Binding Playback.NextTrackCommand}">
                                    <PathIcon Width="14" Height="14" Data="M18,3 H21 V21 H18 Z M3,3 L17,12 L3,21 Z"
                                              Foreground="{DynamicResource AppTextBrush}" />
                                </Button>
                                <Button x:Name="RepeatButton" Classes="icon-button transport" Classes.active="{Binding Playback.IsRepeatEnabled}"
                                        ToolTip.Tip="{Binding Playback.RepeatTooltip}" AutomationProperties.Name="{Binding Playback.RepeatTooltip}"
                                        Command="{Binding Playback.CycleRepeatCommand}">
                                    <Grid Width="16" Height="16">
                                        <Viewbox Width="14" Height="14">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M3,10 V8 A3,3 0 0 1 6,5 H20 M16,1 L20,5 L16,9 M21,14 V16 A3,3 0 0 1 18,19 H4 M8,15 L4,19 L8,23"
                                                      Stroke="{DynamicResource AppTextBrush}" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8" FontWeight="Bold"
                                                   Foreground="{DynamicResource AppTextBrush}" IsVisible="{Binding Playback.IsRepeatOne}"
                                                   Text="{x:Static constants:StreamingConstants.RepeatOneBadge}" />
                                    </Grid>
                                </Button>
                                <Button x:Name="VolumeButton" Classes="icon-button transport"
                                        AutomationProperties.Name="{x:Static constants:StreamingConstants.Volume}"
                                        PointerEntered="OnVolumePointerEntered" PointerExited="OnVolumePointerExited"
                                        Click="OnVolumeClick">
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M2,8 H6 L12,3 V21 L6,16 H2 Z M16,8 Q20,12 16,16 M19,4 Q26,12 19,20"
                                                  Stroke="{DynamicResource AppTextBrush}" StrokeThickness="1.7"
                                                  StrokeLineCap="Round" StrokeJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Popup x:Name="VolumePopup" PlacementTarget="{Binding #VolumeButton}" Placement="Top"
                                       VerticalOffset="-6" IsLightDismissEnabled="False" ShouldUseOverlayLayer="True">
                                    <Border x:Name="VolumePanel" Padding="8" CornerRadius="10" BorderThickness="1"
                                            Background="{DynamicResource AppSurfaceRaisedBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                                            PointerEntered="OnVolumePointerEntered" PointerExited="OnVolumePointerExited">
                                        <Slider x:Name="VolumeSlider" Classes="vertical-volume" Width="24" Height="120"
                                                Orientation="Vertical" Minimum="0" Maximum="100"
                                                Value="{Binding Playback.Volume, Mode=TwoWay}"
                                                AutomationProperties.Name="{x:Static constants:StreamingConstants.Volume}" />
                                    </Border>
                                </Popup>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="TopmostButton" Classes="icon-button"
                                        Classes.active="{Binding AlwaysOnTop}"
                                        ToolTip.Tip="{Binding TopmostTooltip}"
                                        AutomationProperties.Name="{Binding TopmostTooltip}"
                                        Command="{Binding ToggleAlwaysOnTopCommand}">
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M8.5,3 L10.3,8.2 L15.5,10 L10.3,11.8 L8.5,17 L6.7,11.8 L1.5,10 Z M17.5,13 L18.7,16.8 L22.5,18 L18.7,19.2 L17.5,23 L16.3,19.2 L12.5,18 Z M18.5,1 L19.2,3.3 L21.5,4 L19.2,4.7 L18.5,7 L17.8,4.7 L15.5,4 L17.8,3.3 Z"
                                                  Stroke="{DynamicResource AppTextBrush}"
                                                  StrokeThickness="1.5"
                                                  StrokeJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Button x:Name="AccountButton"
                                        Classes="icon-button"
                                        IsVisible="{Binding HasClientId}"
                                        Classes.active="{Binding State.IsConnected}"
                                        ToolTip.Tip="{Binding AccountTooltip}"
                                        AutomationProperties.Name="{Binding AccountTooltip}"
                                        Command="{Binding AccountCommand}">
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M4,21 V19 A8,8 0 0 1 20,19 V21 M16,7 A4,4 0 1 1 8,7 A4,4 0 1 1 16,7 Z"
                                                  Stroke="{DynamicResource AppTextBrush}"
                                                  StrokeThickness="1.5"
                                                  StrokeLineCap="Round"
                                                  StrokeJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Button Classes="icon-button"
                                        ToolTip.Tip="{x:Static constants:SettingsConstants.Settings}"
                                        AutomationProperties.Name="{x:Static constants:SettingsConstants.Settings}"
                                        Command="{Binding OpenSettingsCommand}">
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M9,1 L15,1 L15.6,4.2 L17,5 L20.1,3.9 L23.1,9.1 L20.6,11.2 L20.6,12.8 L23.1,14.9 L20.1,20.1 L17,19 L15.6,19.8 L15,23 L9,23 L8.4,19.8 L7,19 L3.9,20.1 L0.9,14.9 L3.4,12.8 L3.4,11.2 L0.9,9.1 L3.9,3.9 L7,5 L8.4,4.2 Z M16,12 A4,4 0 1 1 8,12 A4,4 0 1 1 16,12 Z"
                                                  Stroke="{DynamicResource AppTextBrush}"
                                                  StrokeThickness="1.5"
                                                  StrokeJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
                <Grid Grid.Row="1" IsVisible="{Binding IsSettingsOpen}">
                    <views:SettingsView DataContext="{Binding Settings}" />
                </Grid>
                <Border Grid.RowSpan="2"
                        ZIndex="10"
                        Background="#99000000"
                        CornerRadius="14"
                        IsVisible="{Binding IsLogoutConfirmationOpen}">
                    <Border Width="340"
                            Padding="20,20,20,24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            KeyboardNavigation.TabNavigation="Cycle">
                        <StackPanel Spacing="16">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Static constants:AuthenticationConstants.SignOut}" />
                            <TextBlock FontSize="14" TextWrapping="Wrap" Text="{x:Static constants:AuthenticationConstants.ConfirmLogout}" />
                            <Grid ColumnDefinitions="*,10,*">
                                <Button x:Name="CancelLogoutButton"
                                        Classes="secondary dialog-action"
                                        HorizontalAlignment="Stretch"
                                        Content="{x:Static constants:CommonConstants.Cancel}"
                                        IsCancel="True"
                                        IsDefault="True"
                                        Command="{Binding CancelLogoutCommand}" />
                                <Button Grid.Column="2"
                                        Classes="primary dialog-action"
                                        HorizontalAlignment="Stretch"
                                        Content="{x:Static constants:AuthenticationConstants.SignOut}"
                                        Command="{Binding ConfirmLogoutCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Border>
        <Border Classes="resize-handle" Height="5" Margin="8,0" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNorthSouth" Tag="North" PointerPressed="OnResizePointerPressed" />
        <Border Classes="resize-handle" Height="5" Margin="8,0" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNorthSouth" Tag="South" PointerPressed="OnResizePointerPressed" />
        <Border Classes="resize-handle" Width="5" Margin="0,8" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWestEast" Tag="West" PointerPressed="OnResizePointerPressed" />
        <Border Classes="resize-handle" Width="5" Margin="0,8" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWestEast" Tag="East" PointerPressed="OnResizePointerPressed" />
        <Border Classes="resize-handle" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="TopLeftCorner" Tag="NorthWest" PointerPressed="OnResizePointerPressed" />
        <Border Classes="resize-handle" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="TopRightCorner" Tag="NorthEast" PointerPressed="OnResizePointerPressed" />
        <Border Classes="resize-handle" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomLeftCorner" Tag="SouthWest" PointerPressed="OnResizePointerPressed" />
        <Border Classes="resize-handle" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner" Tag="SouthEast" PointerPressed="OnResizePointerPressed" />
    </Grid>
</Window>
