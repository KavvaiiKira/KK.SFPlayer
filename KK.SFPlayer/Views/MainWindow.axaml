<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KK.SFPlayer.Views.MainWindow"
        Width="450"
        Height="450"
        MinWidth="450"
        MaxWidth="450"
        MinHeight="450"
        MaxHeight="450"
        CanResize="False"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        FontFamily="{DynamicResource BrandFontFamily}"
        Title="KK.SFPlayer">
    <Border Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid RowDefinitions="44,*">
            <Border Background="{DynamicResource AppSurfaceBrush}"
                    CornerRadius="14,14,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <Border Background="Transparent"
                            PointerPressed="OnTitleBarPointerPressed">
                        <TextBlock Margin="16,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextMutedBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="KK.SFPlayer" />
                    </Border>
                    <StackPanel Grid.Column="1"
                                Margin="16,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="10">
                        <Button Classes="window-control minimize"
                                AutomationProperties.Name="Свернуть"
                                ToolTip.Tip="Свернуть"
                                Click="OnMinimizeClick" />
                        <Button Classes="window-control close"
                                AutomationProperties.Name="Закрыть"
                                ToolTip.Tip="Закрыть"
                                Click="OnCloseClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
