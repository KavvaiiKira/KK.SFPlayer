<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:constants="using:KK.SFPlayer.Constants"
             xmlns:controls="using:KK.SFPlayer.Controls"
             x:Class="KK.SFPlayer.Controls.RemoteImage"
             x:Name="Root"
             x:DataType="controls:RemoteImage"
             x:CompileBindings="True">
    <Grid>
        <Image Source="{Binding #Root.Artwork}" Stretch="{Binding #Root.Stretch}" />
        <controls:PlayerBrand Margin="3" IsVisible="{Binding #Root.IsPlaceholderVisible}"
                              IsSpinning="{Binding #Root.IsPlaceholderVisible}" />
        <Button Width="18"
                Height="18"
                MinWidth="0"
                MinHeight="0"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="{DynamicResource AppSurfaceRaisedBrush}"
                Foreground="{DynamicResource AppTextMutedBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="9"
                ToolTip.Tip="{Binding #Root.ErrorMessage}"
                AutomationProperties.Name="{x:Static constants:ArtworkConstants.RetryArtwork}"
                IsVisible="{Binding #Root.IsRetryVisible}"
                Click="OnRetryClick">
            <TextBlock FontFamily="Segoe UI Symbol"
                       FontSize="14"
                       LineHeight="16"
                       Text="{x:Static constants:ArtworkConstants.RetryArtworkIcon}" />
        </Button>
    </Grid>
</UserControl>
