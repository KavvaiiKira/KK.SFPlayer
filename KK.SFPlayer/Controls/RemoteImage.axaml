<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:constants="using:KK.SFPlayer.Constants"
             xmlns:controls="using:KK.SFPlayer.Controls"
             x:Class="KK.SFPlayer.Controls.RemoteImage"
             x:Name="Root"
             x:DataType="controls:RemoteImage"
             x:CompileBindings="True">
    <UserControl.Styles>
        <Style Selector="Grid.record[IsVisible=True]">
            <Style.Animations>
                <Animation Duration="0:0:6" IterationCount="Infinite" Easing="LinearEasing">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>
    <Grid>
        <Image Source="{Binding #Root.Artwork}" Stretch="{Binding #Root.Stretch}" />
        <Viewbox Margin="3" Stretch="Uniform" IsVisible="{Binding #Root.IsPlaceholderVisible}">
            <Grid Width="64"
                  Height="64"
                  Classes="record"
                  RenderTransformOrigin="50%,50%"
                  IsVisible="{Binding #Root.IsPlaceholderVisible}">
                <Grid.RenderTransform>
                    <RotateTransform />
                </Grid.RenderTransform>
                <Ellipse Fill="#151022" StrokeThickness="4">
                    <Ellipse.Stroke>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Offset="0" Color="#FFC2E8" />
                            <GradientStop Offset="1" Color="#FF829D" />
                        </LinearGradientBrush>
                    </Ellipse.Stroke>
                </Ellipse>
                <Ellipse Margin="8" Stroke="{DynamicResource AppBorderBrush}" StrokeThickness="0.75" Opacity="0.5" />
                <Ellipse Margin="12" Stroke="{DynamicResource AppBorderBrush}" StrokeThickness="0.75" Opacity="0.35" />
                <Path Data="M30,17 L49,13 L49,39 C49,43 45,46 41,46 C37,46 34,44 34,41 C34,37 38,34 43,34 L43,22 L30,25 L30,44 C30,48 26,51 22,51 C18,51 15,49 15,46 C15,42 19,39 24,39 L24,21 C24,19 26,18 30,17 Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Offset="0" Color="#7CC4FF" />
                            <GradientStop Offset="1" Color="#C4B5FD" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
            </Grid>
        </Viewbox>
        <Button Width="18"
                Height="18"
                MinWidth="0"
                MinHeight="0"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="{DynamicResource AppSurfaceRaisedBrush}"
                Foreground="{DynamicResource AppTextMutedBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="9"
                ToolTip.Tip="{Binding #Root.ErrorMessage}"
                AutomationProperties.Name="{x:Static constants:ArtworkConstants.RetryArtwork}"
                IsVisible="{Binding #Root.HasFailed}"
                Click="OnRetryClick">
            <TextBlock FontFamily="Segoe UI Symbol"
                       FontSize="14"
                       LineHeight="16"
                       Text="{x:Static constants:ArtworkConstants.RetryArtworkIcon}" />
        </Button>
    </Grid>
</UserControl>
