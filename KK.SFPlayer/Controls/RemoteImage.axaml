<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:constants="using:KK.SFPlayer.Constants"
             xmlns:controls="using:KK.SFPlayer.Controls"
             x:Class="KK.SFPlayer.Controls.RemoteImage"
             x:Name="Root"
             x:DataType="controls:RemoteImage"
             x:CompileBindings="True">
    <Grid>
        <Image Source="{Binding #Root.Artwork}" Stretch="{Binding #Root.Stretch}" />
        <Viewbox Width="18" Height="18" IsVisible="{Binding #Root.IsPlaceholderVisible}">
            <Canvas Width="24" Height="24">
                <Path Data="M9,18 V5 L21,3 V16 M9,8 L21,6 M9,18 A3,3 0 1 1 3,18 A3,3 0 1 1 9,18 M21,16 A3,3 0 1 1 15,16 A3,3 0 1 1 21,16"
                      Stroke="{DynamicResource AppTextMutedBrush}"
                      StrokeThickness="1.5"
                      StrokeJoin="Round" />
            </Canvas>
        </Viewbox>
        <Button MinWidth="0"
                MinHeight="0"
                Padding="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="Transparent"
                Foreground="{DynamicResource AppTextMutedBrush}"
                BorderThickness="0"
                ToolTip.Tip="{Binding #Root.ErrorMessage}"
                AutomationProperties.Name="{x:Static constants:ArtworkConstants.RetryArtwork}"
                IsVisible="{Binding #Root.HasFailed}"
                Click="OnRetryClick">
            <TextBlock FontFamily="Segoe UI Symbol"
                       FontSize="20"
                       LineHeight="22"
                       Text="{x:Static constants:ArtworkConstants.RetryArtworkIcon}" />
        </Button>
    </Grid>
</UserControl>
